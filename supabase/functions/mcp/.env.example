# SUPABASE_URL and SUPABASE_ANON_KEY are injected by the Edge runtime.
MCP_RESOURCE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/mcp
MCP_CLIENT_ID=PRE_REGISTERED_CHATGPT_CLIENT_UUID
MCP_ALLOWED_ORIGINS=https://chatgpt.com
# Deploy in connection-only mode first. Enable tools only after the OAuth gate.
MCP_PROBE_ONLY=true
